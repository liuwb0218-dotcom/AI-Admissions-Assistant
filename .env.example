# ===== 数据库 =====
# 首次启动会自动执行 CREATE DATABASE IF NOT EXISTS aistudent
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/aistudent?charset=utf8mb4

# ===== JWT =====
JWT_SECRET=please-change-this-to-a-random-string
JWT_EXPIRE_MINUTES=120

# ===== 大模型 =====
# local = 本地 Ollama；deepseek = 云端；mock = 纯模板（不联网，仅用于测试）
LLM_PROVIDER=local
LLM_FALLBACK_TO_MOCK=true

# 本地 Ollama（OpenAI 兼容端点）
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_LLM_TIMEOUT=120

# DeepSeek（选 deepseek 时填写自己的 Key）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT=15

# ===== 检索 =====
RETRIEVAL_TOP_K=5
HISTORY_ROUNDS=5

# ===== 数据源（默认指向仓库内 data/ 目录，无需修改）=====
NEU_SCORE_CSV=data/gkcx/东北师大_历年分数线_全量.csv
NEU_PLAN_CSV=data/gkcx/东北师大_历年招生计划_含学费.csv
COLLEGE_INTRO_DIR=data/college_intro
